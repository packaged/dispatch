{
  "name": "packaged/dispatch",
  "description": "Asset Management Middleware for Stack PHP",
  "license": "MIT",
  "authors": [
    {
      "name": "Brooke Bryan",
      "email": "brooke@bajb.net"
    }
  ],
  "bin": [
    "bin/dispatch"
  ],
  "require": {
    "packaged/helpers": "~1.15",
    "packaged/config": "~1.0",
    "symfony/http-kernel": "~3.2",
    "symfony/console": "~3.2",
    "tedivm/jshrink": "~1.0"
  },
  "require-dev": {
    "php": ">=7.0",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Packaged\\Dispatch\\": "src"
    }
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "policy": {
      "advisories": {
        "block": false
      }
    }
  }
}
